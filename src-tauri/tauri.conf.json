{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "O Muse",
  "version": "0.2.1",
  "identifier": "work.xsin.omuse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "O Muse",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../assets/logo.png"
    ],
    "externalBin": [
      "bin/python-stem-backend"
    ],
    "resources": {
      "../python-backend": "python-backend"
    }
  }
}
